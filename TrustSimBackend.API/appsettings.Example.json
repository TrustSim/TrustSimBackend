{
  "ConnectionStrings": {
    "DefaultConnection": "Host=localhost;Port=5433;Database=trustsim_db;Username=postgres;Password=YOUR_PASSWORD;Include Error Detail=true;",
    "Redis": "localhost:6379,abortConnect=false"
  },
  "JwtSettings": {
    "SecretKey": "YOUR_SUPER_SECRET_KEY_WITH_SUFFICIENT_LENGTH_FOR_HMACSHA256!",
    "Issuer": "TrustSimBackend",
    "Audience": "TrustSimClient",
    "AccessTokenExpiryMinutes": 15,
    "RefreshTokenExpiryDays": 7
  },
  "SePay": {
    "ApiUrl": "https://my.sepay.vn/userapi",
    "ApiKey": "YOUR_SEPAY_API_KEY",
    "AccountNumber": "YOUR_BANK_ACCOUNT_NUMBER",
    "BankName": "Sacombank",
    "AccountHolderName": "YOUR_ACCOUNT_HOLDER_NAME",
    "WebhookToken": "YOUR_SEPAY_WEBHOOK_TOKEN",
    "WebhookUrl": "https://your-domain-or-ngrok/api/wallets/sepay-webhook",
    "QrTemplate": "compact2",
    "PaymentPrefix": "TS",
    "TransactionExpiryMinutes": 30
  },
  "EmailSettings": {
    "SmtpServer": "smtp.gmail.com",
    "SmtpPort": 587,
    "SenderName": "TrustSim Notification System",
    "SenderEmail": "your_email@gmail.com",
    "Username": "your_email@gmail.com",
    "Password": "YOUR_GMAIL_APP_PASSWORD",
    "EnableSsl": true,
    "UseStartTls": true,
    "TimeoutSeconds": 15
  },
  "SpeedSms": {
    "RootUrl": "https://api.speedsms.vn/index.php",
    "ApiKey": "YOUR_SPEEDSMS_API_KEY",
    "Sender": "YOUR_SPEEDSMS_SENDER_ID",
    "SmsType": 5,
    "TimeoutSeconds": 30,
    "OtpExpiryMinutes": 5,
    "CooldownSeconds": 60,
    "MaxFailedAttempts": 3
  },
  "AwsRekognitionSettings": {
    "AccessKey": "YOUR_AWS_ACCESS_KEY",
    "SecretKey": "YOUR_AWS_SECRET_KEY",
    "Region": "ap-southeast-2",
    "MinConfidenceThreshold": 80.0,
    "AutoApproveSimilarityThreshold": 85.0,
    "ManualReviewSimilarityThreshold": 70.0
  },
  "GeminiSettings": {
    "BaseUrl": "https://generativelanguage.googleapis.com/v1beta/openai/",
    "ApiKey": "YOUR_GEMINI_API_KEY",
    "ChatModel": "gemini-3.1-flash-lite",
    "EmbeddingModel": "gemini-embedding-001",
    "EmbeddingDimension": 2048,
    "TimeoutSeconds": 60
  },
  "SellerDepositSettings": {
    "DepositRate": 0.10,
    "MinDepositAmount": 500000.0,
    "MaxDepositAmount": 500000000.0
  },
  "TradeDeadlineSettings": {
    "EscrowDeadlineHours": 48,
    "SigningDeadlineHours": 24,
    "CarrierTransferWaitHours": 48,
    "TransferDeadlineDays": 7,
    "LiquidationSigningDeadlineHours": 24,
    "AutoEnforceGracePeriodHours": 24
  },
  "Supabase": {
    "Url": "http://localhost:8000",
    "AnonKey": "YOUR_SUPABASE_ANON_KEY",
    "Bucket": "pdf-files"
  },
  "SoftHsm": {
    "BaseUrl": "http://localhost:8080",
    "ApiKey": "YOUR_CRYPTO_HSM_API_KEY",
    "FinancialKeyLabel": "trustsim:financial:master-ledger-ecdsa",
    "ContractKeyLabel": "trustsim:contract:master-signing-key",
    "EnvelopeKeyLabel": "trustsim:system:envelope-master-key",
    "TimeoutSeconds": 60,
    "RetryCount": 3,
    "EnableRemoteHsm": true,
    "EnableKeepAlive": true,
    "UseHybridVerification": true
  },
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "AllowedHosts": "*"
}
